{
  "name": "@truff-apps/monorepo",
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo dev --ui=tui",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "build:web": "pnpm --filter @truff-apps/web build",
    "deploy:web": "pnpm build:web && wrangler deploy"
  },
  "devDependencies": {
    "@adonisjs/eslint-plugin": "^2.2.2",
    "@julr/tooling-configs": "^6.1.2",
    "@types/node": "^25.5.0",
    "lefthook": "^2.1.3",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "oxlint-tsgolint": "^0.17.0",
    "railway": "^3.17.0",
    "turbo": "^2.8.18",
    "typescript": "^5.9.3",
    "wrangler": "^4.163.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
